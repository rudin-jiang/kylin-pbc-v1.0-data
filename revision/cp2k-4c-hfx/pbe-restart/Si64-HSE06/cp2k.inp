# CP2K HSE06 = four-center HFX + ADMM, restarted from the PBE wavefunction with SCREEN_ON_INITIAL_P
# Reviewer-2 point-6 rerun (64 atoms); generated by ~/tmp-review-cp2k/gen.py
&GLOBAL
  PROJECT Si64-HSE06-4c-ADMM-fromPBE
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_ADMM
    BASIS_SET_FILE_NAME BASIS_ADMM_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    WFN_RESTART_FILE_NAME Si64-PBE-RESTART.wfn
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_TYPE ADMMS
      EXCH_CORRECTION_FUNC DEFAULT
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
      EPS_PGF_ORB 1.0E-6
      PW_GRID_BLOCKED FALSE
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-6
      MAX_SCF 50
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
        ENERGY_GAP 0.05
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 50
      &END OUTER_SCF
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &PBE
          SCALE_X 0.0
          SCALE_C 1.0
        &END PBE
        &XWPBE
          SCALE_X -0.25
          SCALE_X0 1.0
          OMEGA 0.11
        &END XWPBE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 0.25
        &SCREENING
          EPS_SCHWARZ 1.0E-6
          SCREEN_ON_INITIAL_P TRUE
        &END SCREENING
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE SHORTRANGE
          OMEGA 0.11
        &END INTERACTION_POTENTIAL
        &MEMORY
          MAX_MEMORY 12000
        &END MEMORY
      &END HF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A  10.8620000000  0.0000000000  0.0000000000
      B  0.0000000000  10.8620000000  0.0000000000
      C  0.0000000000  0.0000000000  10.8620000000
      PERIODIC XYZ
    &END CELL
