# CP2K PBE = plain GPW (no exact exchange), TRADITIONAL DIAGONALIZATION + Pulay
# (DIIS) mixing + Fermi smearing. Auto-generated by 16_gen_cp2k_pbe_diag.py
# for the Si scaling benchmark (16 atoms).
&GLOBAL
  PROJECT Si16-PBE-GPW-diag
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
      EPS_PGF_ORB 1.0E-6
      PW_GRID_BLOCKED FALSE
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100
      ADDED_MOS 16
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD PULAY_MIXING
        ALPHA 0.4
        NPULAY 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A  5.4310000000  0.0000000000  0.0000000000
      B  0.0000000000  5.4310000000  0.0000000000
      C  0.0000000000  0.0000000000  10.8620000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Si      0.0000000000      0.0000000000      0.0000000000
      Si      0.0000000000      2.7155000000      2.7155000000
      Si      2.7155000000      0.0000000000      2.7155000000
      Si      2.7155000000      2.7155000000      0.0000000000
      Si      1.3577500000      1.3577500000      1.3577500000
      Si      1.3577500000      4.0732500000      4.0732500000
      Si      4.0732500000      1.3577500000      4.0732500000
      Si      4.0732500000      4.0732500000      1.3577500000
      Si      0.0000000000      0.0000000000      5.4310000000
      Si      0.0000000000      2.7155000000      8.1465000000
      Si      2.7155000000      0.0000000000      8.1465000000
      Si      2.7155000000      2.7155000000      5.4310000000
      Si      1.3577500000      1.3577500000      6.7887500000
      Si      1.3577500000      4.0732500000      9.5042500000
      Si      4.0732500000      1.3577500000      9.5042500000
      Si      4.0732500000      4.0732500000      6.7887500000
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
