"""
cell.basis = "gth-dzvp-molopt-sr"
cell.pseudo = "gth-pbe"
cell.unit = "A"
cell.precision = 1e-8      # PySCF default: its natural cell.mesh == Kylin natural mesh
cell.verbose = 4
cell.build()

# Match Kylin SCF.gmesh = 0.6 : scale the natural (estimate_ke_cutoff) FFT mesh
# by 0.6. Kylin's natural mesh equals PySCF's default cell.mesh (verified in
# test_basis_utility.cpp::TestGetCellGmesh), so this gives the same coarse grid
# and keeps the 128-atom FFTDF (esp. HSE06 exact exchange) tractable.
cell.mesh = [max(1, int(round(n * 0.6))) for n in cell.mesh]
cell.build()
print("FFT mesh (gmesh=0.6) =", cell.mesh)

kpts = cell.make_kpts([1, 1, 1])
kmf = pbcdft.KRKS(cell, kpts)
kmf.xc = "HSE06"
kmf.max_cycle = 200
kmf.conv_tol = 1e-7
etot = kmf.kernel()
print("E_tot (Ha) =", etot)

# approximate band gap from k-point eigenvalues
try:
    homo = max(kmf.mo_energy[i][kmf.mo_occ[i] > 0].max() for i in range(len(kpts)))
    lumo = min(kmf.mo_energy[i][kmf.mo_occ[i] == 0].min() for i in range(len(kpts)))
    print("Band gap (eV) =", (lumo - homo) * 27.211386245988)
except Exception as ex:
    print("gap calc skipped:", ex)

print("wall time (s):", time.time() - tic)
print("OMP_NUM_THREADS:", os.getenv("OMP_NUM_THREADS", "not set"))
