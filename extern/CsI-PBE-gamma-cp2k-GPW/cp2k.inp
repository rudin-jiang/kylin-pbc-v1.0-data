# CP2K input for CsI-PBE-gamma  (external benchmark; basis/pseudo match kylin & pyscf)
# Cs/I: GTH-PBE-q9/q7; for HSE06 AUX_FIT = cFIT9/cFIT7 (BASIS_ADMM_MOLOPT, q-matched).
&GLOBAL
  PROJECT CsI-PBE-gamma
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A      4.5670000000     0.0000000000     0.0000000000
      B      0.0000000000     4.5670000000     0.0000000000
      C      0.0000000000     0.0000000000     4.5670000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Cs      0.0000000000     0.0000000000     0.0000000000
      I       2.2835000000     2.2835000000     2.2835000000
    &END COORD
    &KIND Cs
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND I
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
