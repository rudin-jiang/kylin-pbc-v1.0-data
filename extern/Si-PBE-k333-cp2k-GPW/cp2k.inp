# CP2K input for Si-PBE-k333  (external benchmark; basis/pseudo match kylin & pyscf)
&GLOBAL
  PROJECT Si-PBE-k333
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 3
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A      0.0000000000     2.7155000000     2.7155000000
      B      2.7155000000     0.0000000000     2.7155000000
      C      2.7155000000     2.7155000000     0.0000000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Si      0.0000000000     0.0000000000     0.0000000000
      Si      1.3577500000     1.3577500000     1.3577500000
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
