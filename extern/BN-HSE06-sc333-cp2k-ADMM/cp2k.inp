# CP2K input for BN-HSE06-sc333  (external benchmark; 3x3x3 supercell, Gamma point)
# HSE06 = RI-HFX (short-range, omega=0.11 a0^-1) + ADMM  (requirement.md).
# 3x3x3 supercell at Gamma replaces primitive-cell k333: RI-HFXk on the tiny
#   primitive cell over-extends the RI basis (SR range ~20 A >> half BvK ~3.8 A)
#   and crashes (SIGSEGV); the supercell-Gamma run is the equivalent, runnable
#   counterpart (no &KPOINTS -> standard gamma RI-HFX).
&GLOBAL
  PROJECT BN-HSE06-sc333
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_ADMM
    BASIS_SET_FILE_NAME BASIS_ADMM_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    AUTO_BASIS RI_HFX MEDIUM
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_TYPE ADMMS
      EXCH_CORRECTION_FUNC DEFAULT
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
      EPS_PGF_ORB 1.0E-6
      PW_GRID_BLOCKED FALSE
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      EPS_DIIS 0.05
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &PBE
          SCALE_X 0.0
          SCALE_C 1.0
        &END PBE
        &XWPBE
          SCALE_X -0.25
          SCALE_X0 1.0
          OMEGA 0.11
        &END XWPBE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 0.25
        &RI
          EPS_FILTER 1.0E-9
          EPS_PGF_ORB 1.0E-6
        &END RI
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE SHORTRANGE
          OMEGA 0.11
        &END INTERACTION_POTENTIAL
      &END HF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A      0.0000000000     5.4225000000     5.4225000000
      B      5.4225000000     0.0000000000     5.4225000000
      C      5.4225000000     5.4225000000     0.0000000000
      PERIODIC XYZ
    &END CELL
    &COORD
      B       0.0000000000     0.0000000000     0.0000000000
      N       0.9037500000     0.9037500000     0.9037500000
      B       1.8075000000     1.8075000000     0.0000000000
      N       2.7112500000     2.7112500000     0.9037500000
      B       3.6150000000     3.6150000000     0.0000000000
      N       4.5187500000     4.5187500000     0.9037500000
      B       1.8075000000     0.0000000000     1.8075000000
      N       2.7112500000     0.9037500000     2.7112500000
      B       3.6150000000     1.8075000000     1.8075000000
      N       4.5187500000     2.7112500000     2.7112500000
      B       5.4225000000     3.6150000000     1.8075000000
      N       6.3262500000     4.5187500000     2.7112500000
      B       3.6150000000     0.0000000000     3.6150000000
      N       4.5187500000     0.9037500000     4.5187500000
      B       5.4225000000     1.8075000000     3.6150000000
      N       6.3262500000     2.7112500000     4.5187500000
      B       7.2300000000     3.6150000000     3.6150000000
      N       8.1337500000     4.5187500000     4.5187500000
