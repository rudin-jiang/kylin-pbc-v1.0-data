      N       0.9037500000     2.7112500000     2.7112500000
      B       1.8075000000     3.6150000000     1.8075000000
      N       2.7112500000     4.5187500000     2.7112500000
      B       3.6150000000     5.4225000000     1.8075000000
      N       4.5187500000     6.3262500000     2.7112500000
      B       1.8075000000     1.8075000000     3.6150000000
      N       2.7112500000     2.7112500000     4.5187500000
      B       3.6150000000     3.6150000000     3.6150000000
      N       4.5187500000     4.5187500000     4.5187500000
      B       5.4225000000     5.4225000000     3.6150000000
      N       6.3262500000     6.3262500000     4.5187500000
      B       3.6150000000     1.8075000000     5.4225000000
      N       4.5187500000     2.7112500000     6.3262500000
      B       5.4225000000     3.6150000000     5.4225000000
      N       6.3262500000     4.5187500000     6.3262500000
      B       7.2300000000     5.4225000000     5.4225000000
      N       8.1337500000     6.3262500000     6.3262500000
      B       0.0000000000     3.6150000000     3.6150000000
